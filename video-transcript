#!/usr/bin/env bash
# video-transcript — thin wrapper so you can call ./video-transcript instead of python3 cli/video_transcript.py
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"

exec python3 "$here/cli/video_transcript.py" "$@"
